---
import Layout from '../layouts/Layout.astro';
import BonusCard from '../components/BonusCard.astro';
import KombiCard from '../components/KombiCard.astro';
import MatchCard from '../components/MatchCard.astro';
import { competitionLabel, firstKickoff, formatKickoff, lastKickoff, loadBonus, loadKombis, loadMatchdays, loadResults, loadSchedule, nextMatchday, resultsFor, scoredMatch } from '../lib/data.mjs';

const matchdays = loadMatchdays();
const results = loadResults();
const current = matchdays.at(-1);
const scored = current ? resultsFor(current, results) : undefined;
const latestKombi = loadKombis().at(-1);
const bonus = loadBonus();

// Kicker nennt Wettbewerb und Saison, die Überschrift darunter die Runde.
// Vorher stand die Nummer zweimal da ("Bundesliga · Runde 1" über "1. Spieltag");
// die Saison dagegen stand nirgends - im Archiv, wo Runden mehrerer Spielzeiten
// untereinander stehen, fehlte sie spürbar. Turnier-Labels tragen ihr Jahr schon
// im Namen ("WM 2026"), dort wird nichts angehängt.
function seasonLabelOf(md) {
  if (!md) return '';
  const label = competitionLabel(md.competition);
  return /\d{4}/.test(label) ? label : `${label} ${md.season}/${String(md.season + 1).slice(-2)}`;
}
const seasonLabel = seasonLabelOf(current);

// Zeitfenster: Ein abgelaufener Spieltag samt Kombi bleibt KEEP_DAYS nach dem
// letzten Anstoß stehen, danach zeigt die Seite den Spielplan der nächsten
// Runde. Die Seite ist statisch und wird nur bei neuen Daten gebaut - deshalb
// trägt jedes zeitabhängige Element seine Grenzen als data-Attribute, und das
// Skript am Seitenende zieht sie im Browser nach.
const DAY_MS = 86_400_000;
const KEEP_DAYS = 4;
// Mehr Abstand zwischen zwei Runden ist keine normale Spielwoche mehr.
const PAUSE_DAYS = 9;
const MATCH_MS = 2 * 3_600_000;
const now = Date.now();

// Explizit statt per Spread: Astro hängt sonst ein zweites class-Attribut an
// und die scoped Styles greifen nicht mehr.
function win(from = -Infinity, until = Infinity) {
  return {
    from: Number.isFinite(from) ? from : undefined,
    until: Number.isFinite(until) ? until : undefined,
    hidden: !(now >= from && now < until),
  };
}

const schedule = current ? loadSchedule() : [];
const isCurrent = (md) =>
  md.competition === current?.competition && md.season === current?.season && md.matchday === current?.matchday;
// Tipp-Dateien wachsen erst kurz vor jedem Anstoß. Für Zeitfenster und
// Countdown ergänzen wir die noch ungetippten Partien aus dem Spielplan.
// Neu terminierte Anstoßzeiten aus dem Spielplan haben dabei Vorrang.
const currentMatches = new Map();
for (const m of [...(current?.matches ?? []), ...(schedule.find(isCurrent)?.matches ?? [])]) {
  currentMatches.set(JSON.stringify([m.home, m.away]), m);
}
const currentWithSchedule = current ? { ...current, matches: [...currentMatches.values()] } : undefined;
const lastKick = currentWithSchedule ? lastKickoff(currentWithSchedule) : '';
const recentUntil = lastKick ? Date.parse(lastKick) + KEEP_DAYS * DAY_MS : Infinity;
const next = current ? nextMatchday(schedule, current, lastKick) : undefined;
const nextFirst = next ? firstKickoff(next) : '';
const nextStart = next ? Date.parse(nextFirst) : Infinity;

function pauseLabel() {
  if (!next || nextStart - Date.parse(lastKick) < PAUSE_DAYS * DAY_MS) return null;
  if (next.competition !== current.competition || next.season !== current.season) return 'Saisonpause';
  const winter = new Date(lastKick).getUTCMonth() === 11 || new Date(nextFirst).getUTCMonth() === 0;
  return winter ? 'Winterpause' : 'Länderspielpause';
}
const pause = pauseLabel();

// Ohne bekannte nächste Runde bleibt der letzte Spieltag stehen - sonst wäre die Seite leer.
const recentWin = next ? win(-Infinity, recentUntil) : win();
const upcomingWin = win(next ? recentUntil : Infinity);
const kombiWin = latestKombi
  ? win(-Infinity, Date.parse(latestKombi.reveal_after_utc) + KEEP_DAYS * DAY_MS)
  : win();
// Der nächste Anstoß ist erst bekannt, sobald die Saison-Bonusfragen versiegelt
// sind: deren Tippfrist IST der erste Anstoß der Saison. Vorher kennt die Site
// den Spielplan nicht - sie liest nur data/, und dort steht bis dahin nichts.
const nextKickoff =
  bonus?.reveal_after_utc && Date.parse(bonus.reveal_after_utc) > Date.now()
    ? bonus.reveal_after_utc
    : null;

const banners = [];
if (!next && lastKick) {
  banners.push({
    main: 'Saisonpause',
    pause: true,
    note: nextKickoff ? `Saisonstart ${formatKickoff(nextKickoff)}` : `Zuletzt getippt: ${formatKickoff(lastKick)}`,
    from: recentUntil,
  });
} else if (pause) {
  banners.push({
    main: pause,
    pause: true,
    note: `Weiter am ${formatKickoff(nextFirst)} mit dem ${next.stage}`,
    from: Date.parse(lastKick) + MATCH_MS,
    until: nextStart,
  });
} else if (next) {
  banners.push({
    main: 'Nächster Spieltag',
    note: `${next.stage} ab ${formatKickoff(nextFirst)}`,
    from: recentUntil,
    until: nextStart,
  });
}

// Countdown: zählt im Browser auf das nächste Einzelspiel herunter. Die Seite
// bekommt dafür die kommenden Anstoßzeiten mit (gleichzeitige Spiele als eine
// Gruppe) - so stimmt der Timer auch, wenn länger nicht neu gebaut wurde.
// Steht schon ein Pausen-Stempel oder Banner da, läuft der Timer dort mit; der
// eigene Countdown-Banner erscheint nur, wenn sonst keiner sichtbar ist.
const COUNTDOWN_GROUPS = 20;
const kickoffGroups = new Map();
for (const m of currentWithSchedule ? [currentWithSchedule, ...schedule.filter((md) => !isCurrent(md))].flatMap((md) => md.matches) : []) {
  const t = Date.parse(m.kickoff_utc);
  if (t + MATCH_MS <= now) continue;
  kickoffGroups.set(t, [...(kickoffGroups.get(t) ?? []), m]);
}
const kickoffs = [...kickoffGroups]
  .sort(([a], [b]) => a - b)
  .slice(0, COUNTDOWN_GROUPS)
  .map(([t, ms]) => ({
    t,
    label: ms.length === 1 ? `${ms[0].home} – ${ms[0].away}` : `${ms.length} Spiele`,
    when: formatKickoff(ms[0].kickoff_utc),
  }));

// Zweifarbiger Hero-Titel: bei "…finale" wird der Suffix abgesetzt eingefärbt,
// sonst das letzte Wort ("1. Runde" -> "1." / "Runde").
function splitTitle(stage) {
  const finale = stage.match(/^(.*?)(finale)$/i);
  if (finale && finale[1]) return [finale[1], finale[2]];
  const idx = stage.lastIndexOf(' ');
  return idx > -1 ? [stage.slice(0, idx + 1), stage.slice(idx + 1)] : ['', stage];
}
const [titlePrefix, titleSuffix] = current ? splitTitle(current.stage) : ['', ''];
const [nextPrefix, nextSuffix] = next ? splitTitle(next.stage) : ['', ''];

const stats = scored?.matches_scored > 0
  ? [
      { value: String(scored.points_total), label: 'Punkte bisher' },
      { value: `${scored.matches_scored}/${current.matches.length}`, label: 'Spiele gewertet' },
      { value: (scored.points_total / scored.matches_scored).toFixed(2), label: 'Punkte / Spiel' },
      ...(scored.brier_avg != null ? [{ value: scored.brier_avg.toFixed(3), label: 'Ø Brier-Score' }] : []),
    ]
  : [];
---

<Layout title="Aktueller Spieltag">
  {current ? (
    <>
      {banners.map((b) => ({ ...b, w: win(b.from, b.until) })).map((b) => b.pause ? (
        <div class="stamp-row" data-from={b.w.from} data-until={b.w.until} hidden={b.w.hidden}>
          <div class="stamp">
            <span class="stamp-main">{b.main}</span>
            <span class="stamp-note">{b.note}</span>
            <span class="stamp-timer" role="timer"></span>
          </div>
        </div>
      ) : (
        <div class="banner" data-from={b.w.from} data-until={b.w.until} hidden={b.w.hidden}>
          <span class="banner-main">{b.main}</span>
          <span class="banner-note">{b.note}</span>
          <span class="banner-timer" role="timer"></span>
        </div>
      ))}

      {kickoffs.length > 0 && (
        <div class="banner" data-kickoffs={JSON.stringify(kickoffs)} data-match-ms={MATCH_MS} hidden>
          <span class="banner-main"></span>
          <span class="banner-note"></span>
          <span class="banner-timer" role="timer"></span>
        </div>
      )}

      <div data-from={recentWin.from} data-until={recentWin.until} hidden={recentWin.hidden}>
        <section class="hero">
          <div class="kicker">
            <span class="kicker-bar"></span>
            <span class="kicker-text">{seasonLabel}</span>
          </div>
          <h1>{titlePrefix}<span class="accent">{titleSuffix}</span></h1>
        </section>

        {current.hinweis && <div class="notice">{current.hinweis}</div>}

        {stats.length > 0 && (
          <section class="stats">
            {stats.map((s) => (
              <div class="stat-tile">
                <span class="stat-value accent">{s.value}</span>
                <span class="stat-label">{s.label}</span>
              </div>
            ))}
          </section>
        )}
      </div>

      {next && (
        <div data-from={upcomingWin.from} data-until={upcomingWin.until} hidden={upcomingWin.hidden}>
          <section class="hero">
            <div class="kicker">
              <span class="kicker-bar"></span>
              <span class="kicker-text">{seasonLabelOf(next)}</span>
            </div>
            <h1>{nextPrefix}<span class="accent">{nextSuffix}</span></h1>
          </section>
          <div class="notice">
            Noch nicht getippt: Der Automat tippt jedes Spiel erst kurz vor Anstoß, damit
            Aufstellungen und aktuelle Quoten einfließen. Bis dahin steht hier der Spielplan.
          </div>
        </div>
      )}

      {latestKombi && (
        <section class="kombi-section" data-from={kombiWin.from} data-until={kombiWin.until} hidden={kombiWin.hidden}>
          <KombiCard kombi={latestKombi} />
        </section>
      )}

      {bonus && (
        <section class="kombi-section">
          <BonusCard bonus={bonus} />
        </section>
      )}

      <section class="matches" data-from={recentWin.from} data-until={recentWin.until} hidden={recentWin.hidden}>
        {current.matches.map((m, i) => (
          <MatchCard match={m} scored={scoredMatch(m, scored)} delay={i * 60} />
        ))}
      </section>

      {next && (
        <section class="fixtures" data-from={upcomingWin.from} data-until={upcomingWin.until} hidden={upcomingWin.hidden}>
          {next.matches.map((m) => (
            <div class="fixture">
              <span class="fixture-time">{formatKickoff(m.kickoff_utc)}</span>
              <span class="fixture-teams">{m.home} – {m.away}</span>
              <span class="fixture-tag">Tipp folgt</span>
            </div>
          ))}
        </section>
      )}

      <script is:inline>
        (() => {
          const windows = document.querySelectorAll('[data-from],[data-until]');
          const cd = document.querySelector('[data-kickoffs]');
          const kickoffs = cd ? JSON.parse(cd.dataset.kickoffs) : [];
          const matchMs = cd ? Number(cd.dataset.matchMs) : 0;
          const pad = (n) => String(n).padStart(2, '0');
          const tick = () => {
            const now = Date.now();
            // Auch bei offenem Tab wechseln Banner und Spieltagskarten zur
            // richtigen Zeit; erst danach das sichtbare Timer-Ziel bestimmen.
            for (const el of windows) {
              const from = el.dataset.from ? Number(el.dataset.from) : -Infinity;
              const until = el.dataset.until ? Number(el.dataset.until) : Infinity;
              el.hidden = !(now >= from && now < until);
            }
            if (!cd) return;
            const [main, note, timer] = cd.children;
            const host = document.querySelector('[data-from]:not([hidden]) [role="timer"]');
            const live = kickoffs.filter((k) => k.t <= now && now < k.t + matchMs);
            const next = kickoffs.find((k) => k.t > now);
            const text = (s, d = Math.floor(s / 86400)) =>
              (d ? `${d} T ` : '') + `${pad(Math.floor(s / 3600) % 24)}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`;
            if (host) host.textContent = next ? `noch ${text(Math.floor((next.t - now) / 1000))}` : '';
            cd.hidden = Boolean(host) || (!live.length && !next);
            if (cd.hidden) return;
            main.textContent = live.length ? 'Läuft gerade' : 'Nächstes Spiel';
            note.textContent = live.length ? live.map((k) => k.label).join(' · ') : `${next.label} · ${next.when}`;
            if (!next) return (timer.textContent = '');
            timer.textContent =
              (live.length ? 'Nächstes Spiel in ' : 'noch ') + text(Math.floor((next.t - now) / 1000));
          };
          tick();
          setInterval(tick, 1000);
        })();
      </script>
    </>
  ) : (
    <>
      <h1>Saisonpause</h1>
      <p>
        Der Automat wartet auf den nächsten Spielplan. Bis dahin:{' '}
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/bilanz/`}>die Bilanz</a>.
      </p>
    </>
  )}
</Layout>

<style>
  /* Sonst gewinnt display:grid/flex der Abschnitte gegen das hidden-Attribut. */
  [hidden] { display: none !important; }

  .banner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    margin-top: 34px;
    padding: 16px 22px;
    border-radius: 16px;
    background: linear-gradient(90deg, rgba(212, 255, 63, 0.14), rgba(212, 255, 63, 0.03));
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(212, 255, 63, 0.35);
    border-left: 6px solid var(--lime);
    box-shadow: var(--glass-highlight), 0 12px 32px rgba(0, 0, 0, 0.35);
    animation: riseIn 0.5s both;
  }
  .banner + .banner { margin-top: 12px; }
  .banner-main {
    font-family: var(--font-display);
    font-size: clamp(20px, 6vw, 32px);
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lime);
    min-width: 0;
    overflow-wrap: anywhere;
    hyphens: auto;
  }
  .banner-note {
    font-size: clamp(10.5px, 2.2vw, 13px);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
  }
  /* Feste Ziffernbreite, sonst zappelt die Zeile im Sekundentakt. */
  .banner-timer {
    margin-left: auto;
    font-size: clamp(15px, 4vw, 20px);
    font-weight: 800;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--lime);
  }
  .banner-timer:empty, .stamp-timer:empty { display: none; }

  /* Pausen-Stempel: bleibt im Textfluss statt über dem Hero zu schweben.
     Ein absolut positionierter Stempel überdeckt auf schmalen Geräten
     zwangsläufig die Überschrift - so überlappt er nur optisch (negativer
     Rand) und verdeckt nie etwas. */
  /* Die Einblend-Animation sitzt auf dem Wrapper, nicht auf dem Stempel:
     riseIn endet auf `transform: none` und würde mit fill-mode `both` die
     Drehung dauerhaft überschreiben. */
  .stamp-row { padding: 34px 10px 0; max-width: 100%; animation: riseIn 0.5s both; }
  .stamp {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 9px 24px 11px;
    color: var(--red);
    /* Tintenkontur statt gefüllter Fläche, plus zweite Linie mit Abstand -
       die Doppelkontur ist das, was einen Gummistempel ausmacht. */
    border: 3px solid var(--red);
    border-radius: 8px;
    outline: 2px solid rgba(255, 77, 94, 0.5);
    outline-offset: 5px;
    background: transparent;
    /* Um die Mitte und nur leicht gedreht: Mit Timer und langer Unterzeile ist
       der Stempel so breit, dass seine rechte Ecke sonst in den Header ragt. */
    transform: rotate(-5deg);
    /* leicht durchscheinend wie aufgedrückte Tinte */
    opacity: 0.82;
  }
  .stamp-main {
    font-family: var(--font-display);
    /* clamp statt Breakpoint-Sprüngen: skaliert stufenlos über alle
       Zwischengrößen, nicht nur an den Extremen */
    font-size: clamp(26px, 6.5vw, 44px);
    line-height: 1;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .stamp-note {
    font-size: clamp(9.5px, 2.1vw, 12px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
    text-align: center;
  }
  /* Feste Ziffernbreite wie beim Banner-Timer. */
  .stamp-timer {
    font-size: clamp(14px, 3.4vw, 19px);
    font-weight: 800;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    /* flacher gedreht, sonst ragt die Ecke aus dem Viewport */
    .stamp { transform: rotate(-3deg); padding: 8px 15px 10px; outline-offset: 4px; }
    .stamp-row { padding-top: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stamp-row { animation: none; }
  }

  .fixtures {
    display: grid;
    gap: 10px;
    margin: 28px 0 0;
    animation: riseIn 0.5s 0.15s both;
  }
  .fixture {
    display: grid;
    grid-template-columns: minmax(170px, auto) 1fr auto;
    align-items: center;
    gap: 6px 18px;
    padding: 14px 20px;
    border-radius: 14px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-highlight);
  }
  .fixture-time {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .fixture-teams { font-weight: 700; }
  .fixture-tag {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    padding: 3px 10px;
  }
  @media (max-width: 560px) {
    .fixture { grid-template-columns: 1fr auto; }
    .fixture-teams { grid-column: 1 / -1; grid-row: 2; }
  }

  .hero { padding: 44px 4px 0; animation: riseIn 0.5s both; }
  .kicker { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
  .kicker-bar {
    width: 44px; height: 5px;
    background: var(--lime);
    transform: skewX(-12deg);
    box-shadow: 0 0 16px rgba(212, 255, 63, 0.5);
  }
  .kicker-text {
    font-size: 13px; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--text-muted);
  }
  .hero h1 { margin: 0; }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 26px;
    animation: riseIn 0.5s 0.1s both;
  }

  .kombi-section { margin-top: 26px; animation: riseIn 0.5s 0.15s both; }

  .matches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 22px;
    margin: 28px 0 0;
  }
</style>
