---
import Layout from '../layouts/Layout.astro';
import BonusCard from '../components/BonusCard.astro';
import KombiCard from '../components/KombiCard.astro';
import MatchCard from '../components/MatchCard.astro';
import { competitionLabel, formatKickoff, lastKickoff, loadBonus, loadKombis, loadMatchdays, loadResults, resultsFor, scoredMatch } from '../lib/data.mjs';

const matchdays = loadMatchdays();
const results = loadResults();
const current = matchdays.at(-1);
const scored = current ? resultsFor(current, results) : undefined;
const latestKombi = loadKombis().at(-1);
const bonus = loadBonus();

const label = current ? competitionLabel(current.competition) : '';

// Kicker nennt Wettbewerb und Saison, die Überschrift darunter die Runde.
// Vorher stand die Nummer zweimal da ("Bundesliga · Runde 1" über "1. Spieltag");
// die Saison dagegen stand nirgends - im Archiv, wo Runden mehrerer Spielzeiten
// untereinander stehen, fehlte sie spürbar. Turnier-Labels tragen ihr Jahr schon
// im Namen ("WM 2026"), dort wird nichts angehängt.
const seasonLabel = !current || /\d{4}/.test(label)
  ? label
  : `${label} ${current.season}/${String(current.season + 1).slice(-2)}`;

// Pausen-Stempel: Solange die letzte getippte Runde länger als BREAK_DAYS her
// ist, läuft gerade nichts - ohne Hinweis liest sich die Startseite so, als
// wäre ein Spieltag von vor Wochen der aktuelle. Rein aus den Daten abgeleitet,
// damit der Stempel von selbst verschwindet, sobald wieder getippt wird (und in
// der Winterpause von selbst wiederkommt).
const BREAK_DAYS = 3;
const lastKick = current ? lastKickoff(current) : '';
const daysSinceLast = lastKick ? (Date.now() - Date.parse(lastKick)) / 86_400_000 : 0;
const inBreak = daysSinceLast >= BREAK_DAYS;
// Der nächste Anstoß ist erst bekannt, sobald die Saison-Bonusfragen versiegelt
// sind: deren Tippfrist IST der erste Anstoß der Saison. Vorher kennt die Site
// den Spielplan nicht - sie liest nur data/, und dort steht bis dahin nichts.
const nextKickoff =
  bonus?.reveal_after_utc && Date.parse(bonus.reveal_after_utc) > Date.now()
    ? bonus.reveal_after_utc
    : null;

// Zweifarbiger Hero-Titel: bei "…finale" wird der Suffix abgesetzt eingefärbt,
// sonst das letzte Wort ("1. Runde" -> "1." / "Runde").
function splitTitle(stage) {
  const finale = stage.match(/^(.*?)(finale)$/i);
  if (finale && finale[1]) return [finale[1], finale[2]];
  const idx = stage.lastIndexOf(' ');
  return idx > -1 ? [stage.slice(0, idx + 1), stage.slice(idx + 1)] : ['', stage];
}
const [titlePrefix, titleSuffix] = current ? splitTitle(current.stage) : ['', ''];

const stats = scored?.matches_scored > 0
  ? [
      { value: String(scored.points_total), label: 'Punkte bisher' },
      { value: `${scored.matches_scored}/${current.matches.length}`, label: 'Spiele gewertet' },
      { value: (scored.points_total / scored.matches_scored).toFixed(2), label: 'Punkte / Spiel' },
      ...(scored.brier_avg != null ? [{ value: scored.brier_avg.toFixed(3), label: 'Ø Brier-Score' }] : []),
    ]
  : [];
---

<Layout title="Aktueller Spieltag">
  {current ? (
    <>
      {inBreak && (
        <div class="stamp-row">
          <div class="stamp">
            <span class="stamp-main">Saisonpause</span>
            <span class="stamp-note">
              {nextKickoff
                ? `Saisonstart ${formatKickoff(nextKickoff)}`
                : `Zuletzt getippt: ${formatKickoff(lastKick)}`}
            </span>
          </div>
        </div>
      )}

      <section class="hero">
        <div class="kicker">
          <span class="kicker-bar"></span>
          <span class="kicker-text">{seasonLabel}</span>
        </div>
        <h1>{titlePrefix}<span class="accent">{titleSuffix}</span></h1>
      </section>

      {current.hinweis && <div class="notice">{current.hinweis}</div>}

      {stats.length > 0 && (
        <section class="stats">
          {stats.map((s) => (
            <div class="stat-tile">
              <span class="stat-value accent">{s.value}</span>
              <span class="stat-label">{s.label}</span>
            </div>
          ))}
        </section>
      )}

      {latestKombi && (
        <section class="kombi-section">
          <KombiCard kombi={latestKombi} />
        </section>
      )}

      {bonus && (
        <section class="kombi-section">
          <BonusCard bonus={bonus} />
        </section>
      )}

      <section class="matches">
        {current.matches.map((m, i) => (
          <MatchCard match={m} scored={scoredMatch(m, scored)} delay={i * 60} />
        ))}
      </section>
    </>
  ) : (
    <>
      <h1>Saisonpause</h1>
      <p>
        Der Automat wartet auf den nächsten Spielplan. Bis dahin:{' '}
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/bilanz/`}>die Bilanz</a>.
      </p>
    </>
  )}
</Layout>

<style>
  /* Pausen-Stempel: bleibt im Textfluss statt über dem Hero zu schweben.
     Ein absolut positionierter Stempel überdeckt auf schmalen Geräten
     zwangsläufig die Überschrift - so überlappt er nur optisch (negativer
     Rand) und verdeckt nie etwas. */
  /* Die Einblend-Animation sitzt auf dem Wrapper, nicht auf dem Stempel:
     riseIn endet auf `transform: none` und würde mit fill-mode `both` die
     Drehung dauerhaft überschreiben. */
  .stamp-row { padding: 34px 10px 0; max-width: 100%; animation: riseIn 0.5s both; }
  .stamp {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 9px 24px 11px;
    color: var(--red);
    /* Tintenkontur statt gefüllter Fläche, plus zweite Linie mit Abstand -
       die Doppelkontur ist das, was einen Gummistempel ausmacht. */
    border: 3px solid var(--red);
    border-radius: 8px;
    outline: 2px solid rgba(255, 77, 94, 0.5);
    outline-offset: 5px;
    background: transparent;
    transform: rotate(-8deg);
    transform-origin: left center;
    /* leicht durchscheinend wie aufgedrückte Tinte */
    opacity: 0.82;
  }
  .stamp-main {
    font-family: var(--font-display);
    /* clamp statt Breakpoint-Sprüngen: skaliert stufenlos über alle
       Zwischengrößen, nicht nur an den Extremen */
    font-size: clamp(26px, 6.5vw, 44px);
    line-height: 1;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .stamp-note {
    font-size: clamp(9.5px, 2.1vw, 12px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
    text-align: center;
  }
  @media (max-width: 560px) {
    /* flacher gedreht, sonst ragt die Ecke aus dem Viewport */
    .stamp { transform: rotate(-4deg); padding: 8px 15px 10px; outline-offset: 4px; }
    .stamp-row { padding-top: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stamp-row { animation: none; }
  }

  .hero { padding: 44px 4px 0; animation: riseIn 0.5s both; }
  .kicker { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
  .kicker-bar {
    width: 44px; height: 5px;
    background: var(--lime);
    transform: skewX(-12deg);
    box-shadow: 0 0 16px rgba(212, 255, 63, 0.5);
  }
  .kicker-text {
    font-size: 13px; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--text-muted);
  }
  .hero h1 { margin: 0; }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 26px;
    animation: riseIn 0.5s 0.1s both;
  }

  .kombi-section { margin-top: 26px; animation: riseIn 0.5s 0.15s both; }

  .matches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 22px;
    margin: 28px 0 0;
  }
</style>
