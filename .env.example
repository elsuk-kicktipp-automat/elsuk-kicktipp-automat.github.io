# Vorlage: nach .env kopieren und ausfüllen. Die .env ist gitignored.

# Versiegelung (Phase 2): Schlüssel für die Fernet-Verschlüsselung der
# Klartext-Tipps. Muss identisch als GitHub Actions Secret hinterlegt sein:
#   gh secret set SEAL_SECRET --repo elsuk-kicktipp-automat/der-automat --body "..."
SEAL_SECRET=

# LLM-Schicht (Phase 3): Groq Free Tier ist der Ersatz für News-Check und
# Bonusfragen, wenn Claude nicht erreichbar ist (config.yaml: llm.provider).
# Key erstellen: https://console.groq.com/keys
GROQ_API_KEY=

# Begründungstexte, News-Check und Bonusfragen: Claude Opus 5.5 über das
# Claude-Abo, kein API-Schlüssel.
# Lokal genügt die angemeldete `claude`-CLI (ab 2.1.280), hier ist nichts
# einzutragen. Für GitHub Actions ein Abo-Token erzeugen (ein Jahr gültig) und
# als Secret hinterlegen:
#   claude setup-token
#   gh secret set CLAUDE_CODE_OAUTH_TOKEN --repo elsuk-kicktipp-automat/elsuk-kicktipp-automat.github.io
# Ohne CLI/Token/Kontingent springen Groq bzw. die Template-Begründung ein.

# Quoten-Prior (concept.md §3): The Odds API, Free Tier 500 Requests/Monat.
# Ohne Key läuft das Modell ohne Quoten-Blend (nur ELO-Prior).
# Key erstellen: https://the-odds-api.com
ODDS_API_KEY=

# Kicktipp-Bot (Phase 4, live) – eigener Bot-Account, nie der persönliche:
KICKTIPP_EMAIL=
KICKTIPP_PASSWORD=
KICKTIPP_RUNDE=
